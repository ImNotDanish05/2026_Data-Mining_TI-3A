# Google YouTube Data API v3 Key (Wajib diisi)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Jalur file CSV input yang memuat link_video, topik_video, tipe_video (Opsional)
INPUT_CSV=input_videos_template.csv

# List Video ID jika tidak menggunakan file CSV (Dipisahkan koma, opsional)
VIDEO_IDS=dQw4w9WgXcQ,jNQXAC9IVRw

# Batas maksimal komentar per video (Default: 100)
MAX_COMMENTS=100

# Direktori penyimpanan hasil CSV (Default: .)
OUTPUT_DIR=.

